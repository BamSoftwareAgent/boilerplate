# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=changeme-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (test keys during development) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
STRIPE_WEBHOOK_SECRET=whsec_…
STRIPE_PRICE_ID=price_…

# ── Resend (transactional email) ─────────────────────────────────────────────
# Full-access key for setup; use a domain-scoped key in production.
RESEND_API_KEY=re_…
# Sender shown to recipients. Use onboarding@resend.dev until your domain is verified.
EMAIL_FROM=App Name <hello@yourdomain.com>

# ── Feature flags ─────────────────────────────────────────────────────────────
STRIPE_TAX_ENABLED=false

# ── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://…@….ingest.sentry.io/…
# Keep SENTRY_AUTH_TOKEN out of .env.local — set it in CI/CD only.
# SENTRY_AUTH_TOKEN=sntrys_…

# ── PostHog ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_…
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Ads (optional — set to enable conversion tag) ─────────────────────
# Format: AW-XXXXXXXXX/YYYYYYY  (account ID / conversion label)
NEXT_PUBLIC_GOOGLE_ADS_ID=
