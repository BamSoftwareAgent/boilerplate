# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=changeme-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (test keys during development) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
# Run: npx stripe listen --forward-to localhost:3000/api/webhooks/stripe
# The CLI prints the webhook secret; paste it here.
STRIPE_WEBHOOK_SECRET=whsec_…
# Run: npm run stripe:setup 2900   (amount in cents, e.g. 2900 = $29/month)
# The script prints the price ID; paste it here.
STRIPE_PRICE_ID=price_…

# ── Feature flags ─────────────────────────────────────────────────────────────
STRIPE_TAX_ENABLED=false

# ── PostHog ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_…
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Ads (optional — set to enable conversion tag) ─────────────────────
# Format: AW-XXXXXXXXX/YYYYYYY  (account ID / conversion label)
NEXT_PUBLIC_GOOGLE_ADS_ID=
